{
  "version": 6,
  "configurePresets": [
    {
      "name": "x86",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../out/x86",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "x86", "configurePreset": "x86" }
  ]
}
